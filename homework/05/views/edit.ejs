<h2>編輯文章</h2>
<form action="/posts/<%= post.id %>" method="POST" class="post-form">
  <div class="form-group">
    <label for="title">標題</label>
    <input type="text" name="title" id="title" value="<%= post.title %>" required>
  </div>
  <div class="form-group">
    <label for="content">內容</label>
    <textarea name="content" id="content" rows="12" required><%= post.content %></textarea>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">更新文章</button>
    <a href="/posts/<%= post.id %>" class="btn btn-secondary">取消</a>
  </div>
</form>
